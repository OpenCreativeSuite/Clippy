namespace Clippy;

public static class Diag
{
    private static readonly object Sync = new();
    public static string Path => System.IO.Path.Combine(System.IO.Path.GetTempPath(), "clippy.log");

    public static void Log(string message)
    {
        try
        {
            lock (Sync)
                File.AppendAllText(Path, DateTime.Now.ToString("HH:mm:ss.fff") + "  " + message + "\n");
        }
        catch { }
    }

    public static void Clear()
    {
        try
        {
            lock (Sync)
                File.WriteAllText(Path, "");
        }
        catch { }
    }
}
