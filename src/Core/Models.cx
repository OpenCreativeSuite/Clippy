using System.Text.Json;
using System.Text.Json.Serialization;

namespace Clippy;

public enum OutputFormat
{
    React,
    Csx,
    Html
}

public enum CaptureStatus
{
    Pending,
    Extracting,
    Ready,
    Error
}

public enum ExtractionMode
{
    Faithful,
    Clean
}

public sealed class PathPart
{    public string Tag { get; set; } = "";
    public string? Id { get; set; }
    public List<string> Classes { get; set; } = [];
    public int Index { get; set; }
    public bool Shadow { get; set; }

    public string Display
    {
        get
        {
            var text = Tag;
            if (!string.IsNullOrEmpty(Id))
                text += "#" + Id;
            if (Classes.Count > 0)
                text += "." + string.Join(".", Classes.Take(2));
            return text;
        }
    }
}

public sealed class SelectionInfo
{
    public string Id { get; set; } = "";
    public string Tag { get; set; } = "";
    public string? DomId { get; set; }
    public List<string> Classes { get; set; } = [];
    public string Label { get; set; } = "";
    public string Selector { get; set; } = "";
    public string Text { get; set; } = "";
    public double Width { get; set; }
    public double Height { get; set; }
    public double X { get; set; }
    public double Y { get; set; }
    public List<PathPart> Path { get; set; } = [];
    public bool InShadow { get; set; }

    [JsonIgnore]
    public string PathKey => string.Join("/", Path.Select(p => p.Index));

    [JsonIgnore]
    public string SizeLabel => $"{Math.Round(Width)} × {Math.Round(Height)}";

    [JsonIgnore]
    public string ClassLabel => Classes.Count == 0 ? "" : "." + string.Join(".", Classes.Take(4));
}

public sealed class PageSnapshot
{
    public string Url { get; set; } = "";
    public string Title { get; set; } = "";
    public int Width { get; set; }
    public int Height { get; set; }
    public double Dpr { get; set; } = 1;
    public bool InspectorActive { get; set; }
    public bool Ready { get; set; }
    public double ScrollX { get; set; }
    public double ScrollY { get; set; }
    public List<SelectionInfo> Selections { get; set; } = [];
}

public sealed class SerializedNode
{
    public int Index { get; set; }
    public string Tag { get; set; } = "";
    public Dictionary<string, string> Attributes { get; set; } = [];
    public string? Text { get; set; }
    public List<SerializedNode> Children { get; set; } = [];
    public Dictionary<string, string> Computed { get; set; } = [];
    public PseudoCapture? Before { get; set; }
    public PseudoCapture? After { get; set; }
    public bool ShadowHost { get; set; }
    public string? ShadowMode { get; set; }
    public int MatchedRules { get; set; }
    public bool Fallback { get; set; }
    public bool IsSvg { get; set; }
    public string? SourceTag { get; set; }

    [JsonIgnore]
    public string FallbackClass => "cc-" + Index;
}

public sealed class PseudoCapture
{
    public string Content { get; set; } = "";
    public Dictionary<string, string> Styles { get; set; } = [];
    public List<string> AssetUrls { get; set; } = [];
}

public sealed class CssRuleInfo
{
    public string Selector { get; set; } = "";
    public string Declarations { get; set; } = "";
    public List<string> Conditions { get; set; } = [];
    public string Source { get; set; } = "";
    public string Origin { get; set; } = "author";
    public bool Recovered { get; set; }
    public int Affects { get; set; }
    public bool Pseudo { get; set; }

    [JsonIgnore]
    public string ConditionLabel => Conditions.Count == 0 ? "Always" : string.Join("  ›  ", Conditions);

    [JsonIgnore]
    public string ShortDeclarations
    {
        get
        {
            var text = Declarations.Replace("\n", " ").Trim();
            return text.Length > 120 ? text[..117] + "…" : text;
        }
    }
}

public sealed class CssFontInfo
{
    public string Family { get; set; } = "";
    public string Weight { get; set; } = "400";
    public string Style { get; set; } = "normal";
    public string Display { get; set; } = "auto";
    public string Src { get; set; } = "";
    public List<string> Urls { get; set; } = [];
    public List<string> LocalPaths { get; set; } = [];
}

public sealed class AssetRef
{
    public string Url { get; set; } = "";
    public string Kind { get; set; } = "image";
    public string? Property { get; set; }
    public int? NodeIndex { get; set; }
    public string? LocalPath { get; set; }
    public string? FileName { get; set; }
    public string? ContentType { get; set; }
    public long Size { get; set; }
    public string? Error { get; set; }
    public byte[]? Data { get; set; }

    [JsonIgnore]
    public bool Ok => Error is null && LocalPath is not null;
}

public sealed class ExtractionWarning
{
    public string Code { get; set; } = "info";
    public string Message { get; set; } = "";
    public string Severity { get; set; } = "warning";
}

public sealed class ContextPart
{
    public string Tag { get; set; } = "";
    public string? Id { get; set; }
    public List<string> Classes { get; set; } = [];
}

public sealed class ExtractedComponent
{
    public string Id { get; set; } = "";
    public string Selector { get; set; } = "";
    public List<PathPart> Path { get; set; } = [];
    public List<ContextPart> ContextChain { get; set; } = [];
    public List<string> StyleSheetHrefs { get; set; } = [];
    public string InlineStyleText { get; set; } = "";
    public string NameHint { get; set; } = "";
    public SerializedNode? Root { get; set; }
    public Dictionary<string, string> RootComputed { get; set; } = [];
    public List<string> UsedFontFamilies { get; set; } = [];
    public string CssText { get; set; } = "";
    public List<CssRuleInfo> Rules { get; set; } = [];
    public List<CssFontInfo> Fonts { get; set; } = [];
    public List<AssetRef> Assets { get; set; } = [];
    public List<ExtractionWarning> Warnings { get; set; } = [];
    public List<string> UnreadableSheets { get; set; } = [];
    public List<string> FlattenedShadowRoots { get; set; } = [];
    public string SourceUrl { get; set; } = "";
    public string PageTitle { get; set; } = "";
    public int ViewportWidth { get; set; }
    public int ViewportHeight { get; set; }
    public double Dpr { get; set; } = 1;
    public int NodeCount { get; set; }
    public bool UsedComputedFallback { get; set; }
    public string ExtractedAt { get; set; } = "";

    [JsonIgnore]
    public int ImageCount => Assets.Count(a => a.Kind != "font");

    [JsonIgnore]
    public int FontCount => Assets.Count(a => a.Kind == "font");
}

public sealed class FormatState
{
    public string Source { get; set; } = "";
    public bool Edited { get; set; }
}

public sealed class ComponentEntry
{
    public string Id { get; set; } = Guid.NewGuid().ToString("n");
    public string SelectionId { get; set; } = "";
    public string Name { get; set; } = "Component";
    public string NameHint { get; set; } = "";
    public CaptureStatus Status { get; set; } = CaptureStatus.Pending;
    public string? Error { get; set; }
    public string SourceUrl { get; set; } = "";
    public string PageTitle { get; set; } = "";
    public int ViewportWidth { get; set; }
    public int ViewportHeight { get; set; }
    public ExtractedComponent? Data { get; set; }
    public string CssText { get; set; } = "";
    public bool CssEdited { get; set; }
    public string? ParentId { get; set; }
    public List<string> ChildIds { get; set; } = [];
    public bool ExposeProperties { get; set; }
    public ExtractionMode Mode { get; set; } = ExtractionMode.Faithful;
    public int Order { get; set; }
    public bool IsExpanded { get; set; } = true;
    public bool DirtyPreview { get; set; } = true;
    public string PreviewHtml { get; set; } = "";
    public string PreviewCss { get; set; } = "";
    public string PreviewDir { get; set; } = "";
    public string PreviewVersion { get; set; } = "";
    public Dictionary<OutputFormat, FormatState> Formats { get; set; } = new()
    {
        [OutputFormat.React] = new FormatState(),
        [OutputFormat.Csx] = new FormatState(),
        [OutputFormat.Html] = new FormatState()
    };
    public List<ExtractionWarning> Warnings { get; set; } = [];
    public List<CssRuleInfo> Rules { get; set; } = [];
    public List<AssetRef> Assets { get; set; } = [];

    [JsonIgnore]
    public SelectionInfo? Selection { get; set; }

    [JsonIgnore]
    public string StatusLabel => Status switch
    {
        CaptureStatus.Pending => "Queued",
        CaptureStatus.Extracting => "Extracting",
        CaptureStatus.Ready => "Ready",
        CaptureStatus.Error => "Failed",
        _ => "Unknown"
    };

    [JsonIgnore]
    public bool IsReady => Status == CaptureStatus.Ready && Data is not null;

    [JsonIgnore]
    public string SelectionLabel => Selection?.Label ?? Name;

    [JsonIgnore]
    public string SizeLabel => Selection?.SizeLabel ?? $"{ViewportWidth} × {ViewportHeight}";

    [JsonIgnore]
    public List<AssetRef> ImageAssets => Assets.Where(a => a.Kind != "font").ToList();

    [JsonIgnore]
    public List<AssetRef> FontAssets => Assets.Where(a => a.Kind == "font").ToList();

    [JsonIgnore]
    public int WarningCount => Warnings.Count(w => w.Severity != "info");

    [JsonIgnore]
    public int MediaRuleCount => Rules.Count(r => r.Conditions.Count > 0);
}

public sealed class LiveSelectionMap
{
    public Dictionary<string, SelectionInfo> ById { get; } = [];
    public List<SelectionInfo> Items { get; } = [];
}
