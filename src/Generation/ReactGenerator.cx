using System.Text;
using System.Text.RegularExpressions;

namespace Clippy;

public static class ReactGenerator
{
    private static readonly HashSet<string> VoidTags = new(StringComparer.OrdinalIgnoreCase)
    {
        "area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta",
        "param", "source", "track", "wbr"
    };

    private static readonly Dictionary<string, string> AttributeMap = new(StringComparer.OrdinalIgnoreCase)
    {
        ["class"] = "className",
        ["for"] = "htmlFor",
        ["http-equiv"] = "httpEquiv",
        ["accept-charset"] = "acceptCharset",
        ["autocomplete"] = "autoComplete",
        ["autofocus"] = "autoFocus",
        ["autoplay"] = "autoPlay",
        ["cellpadding"] = "cellPadding",
        ["cellspacing"] = "cellSpacing",
        ["colspan"] = "colSpan",
        ["contenteditable"] = "contentEditable",
        ["crossorigin"] = "crossOrigin",
        ["datetime"] = "dateTime",
        ["enctype"] = "encType",
        ["formaction"] = "formAction",
        ["frameborder"] = "frameBorder",
        ["hreflang"] = "hrefLang",
        ["inputmode"] = "inputMode",
        ["maxlength"] = "maxLength",
        ["minlength"] = "minLength",
        ["novalidate"] = "noValidate",
        ["readonly"] = "readOnly",
        ["rowspan"] = "rowSpan",
        ["spellcheck"] = "spellCheck",
        ["srcdoc"] = "srcDoc",
        ["srclang"] = "srcLang",
        ["srcset"] = "srcSet",
        ["imagesrcset"] = "imageSrcSet",
        ["imagesizes"] = "imageSizes",
        ["tabindex"] = "tabIndex",
        ["usemap"] = "useMap",
        ["allowfullscreen"] = "allowFullScreen",
        ["fetchpriority"] = "fetchPriority"
    };

    private static readonly Dictionary<string, string> SvgAttributeMap = new(StringComparer.OrdinalIgnoreCase)
    {
        ["stroke-width"] = "strokeWidth",
        ["stroke-linecap"] = "strokeLinecap",
        ["stroke-linejoin"] = "strokeLinejoin",
        ["stroke-dasharray"] = "strokeDasharray",
        ["stroke-dashoffset"] = "strokeDashoffset",
        ["stroke-miterlimit"] = "strokeMiterlimit",
        ["stroke-opacity"] = "strokeOpacity",
        ["fill-rule"] = "fillRule",
        ["fill-opacity"] = "fillOpacity",
        ["clip-rule"] = "clipRule",
        ["clip-path"] = "clipPath",
        ["stop-color"] = "stopColor",
        ["stop-opacity"] = "stopOpacity",
        ["text-anchor"] = "textAnchor",
        ["font-family"] = "fontFamily",
        ["font-size"] = "fontSize",
        ["font-weight"] = "fontWeight",
        ["font-style"] = "fontStyle",
        ["dominant-baseline"] = "dominantBaseline",
        ["vector-effect"] = "vectorEffect",
        ["shape-rendering"] = "shapeRendering",
        ["marker-start"] = "markerStart",
        ["marker-mid"] = "markerMid",
        ["marker-end"] = "markerEnd",
        ["gradientunits"] = "gradientUnits",
        ["gradienttransform"] = "gradientTransform",
        ["patternunits"] = "patternUnits",
        ["patterncontentunits"] = "patternContentUnits",
        ["preserveaspectratio"] = "preserveAspectRatio",
        ["xlink:href"] = "xlinkHref",
        ["xml:space"] = "xmlSpace",
        ["xmlns:xlink"] = "xmlnsXlink"
    };

    private static readonly HashSet<string> BooleanAttributes = new(StringComparer.OrdinalIgnoreCase)
    {
        "disabled", "checked", "selected", "readonly", "required", "multiple", "autofocus",
        "autoplay", "controls", "loop", "muted", "novalidate", "open", "hidden", "reversed",
        "allowfullscreen", "default", "defer", "async", "ismap", "nomodule", "playsinline"
    };

    public static string Generate(ComponentEntry entry)
    {
        if (entry.Data?.Root is null)
            return "// No extraction data.";

        var plan = PropertyPlan.Build(entry);
        var name = NameService.FileName(entry.Name);
        var builder = new StringBuilder();
        builder.AppendLine("// " + name + " - generated by Clippy");
        builder.AppendLine("// Source: " + (string.IsNullOrWhiteSpace(entry.SourceUrl) ? "unknown" : entry.SourceUrl));
        builder.AppendLine("// Viewport: " + entry.ViewportWidth + " - " + entry.ViewportHeight);
        builder.AppendLine("// Original JavaScript behaviour is not recreated; markup, styling and assets are.");
        builder.AppendLine();
        builder.AppendLine("import \"./" + name + ".css\";");
        builder.AppendLine();

        if (plan.Active && plan.Items.Count > 0)
        {
            builder.AppendLine("export default function " + name + "({");
            foreach (var item in plan.Items)
            {
                var parameter = Camel(item.Name);
                builder.AppendLine("  " + parameter + " = " + JsString(item.Default) + ",");
            }
            builder.AppendLine("} = {}) {");
        }
        else
        {
            builder.AppendLine("export default function " + name + "() {");
        }

        builder.AppendLine("  return (");
        var markup = RenderNode(entry.Data.Root, plan, entry, isRoot: true, depth: 2);
        foreach (var context in (entry.Data.ContextChain ?? []).Select((value, index) => (value, index)).Reverse())
        {
            markup = new string(' ', 4) + "<div className=\"clippy-context-" + (context.index + 1) + "\">\n" +
                     Indent(markup, 2) +
                     new string(' ', 4) + "</div>\n";
        }
        builder.Append(markup);
        builder.AppendLine("  );");
        builder.AppendLine("}");
        return builder.ToString();
    }

    private static string RenderNode(SerializedNode node, PropertyPlan plan, ComponentEntry entry, bool isRoot, int depth)
    {
        var indent = new string(' ', depth * 2);
        var tag = node.Tag;
        if (string.IsNullOrWhiteSpace(tag))
            return "";

        if (tag == "#text")
        {
            var textIndent = new string(' ', depth * 2);
            var textBuilder = new StringBuilder();
            if (plan.TryText(node, out var textProp))
                textBuilder.Append(textIndent).Append('{').Append(Camel(textProp)).AppendLine("}");
            else if (!string.IsNullOrWhiteSpace(node.Text))
                textBuilder.Append(textIndent).AppendLine(EscapeJsxText(node.Text, false));
            return textBuilder.ToString();
        }

        if (tag is "html" or "body")
            tag = "div";

        var svg = node.IsSvg || node.Attributes.ContainsKey("viewBox") || node.Tag == "svg";
        var voidTag = !svg && VoidTags.Contains(tag);
        var builder = new StringBuilder();
        builder.Append(indent).Append('<').Append(tag);

        var classes = node.Attributes.GetValueOrDefault("class", "");
        var classList = new List<string>();
        if (!string.IsNullOrWhiteSpace(classes))
            classList.Add(classes);
        if (isRoot)
            classList.Insert(0, "clippy-root");
        if (node.Fallback || (node.Index > 0 && node.MatchedRules == 0))
            classList.Add(node.FallbackClass);
        if (classList.Count > 0)
            builder.Append(" className=\"").Append(HtmlEscape.Attribute(string.Join(" ", classList))).Append('"');

        foreach (var kv in node.Attributes)
        {
            var key = kv.Key;
            if (key.Equals("class", StringComparison.OrdinalIgnoreCase))
                continue;
            if (key.StartsWith("on", StringComparison.OrdinalIgnoreCase) && key.Length > 2)
                continue;
            var lower = key.ToLowerInvariant();
            if (lower is "srcdoc" or "integrity" or "nonce" or "ping")
                continue;
            var value = kv.Value;
            if ((lower is "href" or "src" or "action" or "formaction" or "data") &&
                value.TrimStart().StartsWith("javascript:", StringComparison.OrdinalIgnoreCase))
                continue;

            if (plan.TryAttribute(node, lower, out var prop))
            {
                var jsxName = MapAttribute(key, svg);
                builder.Append(' ').Append(jsxName).Append("={").Append(Camel(prop)).Append('}');
                continue;
            }

            if (lower == "style")
            {
                var style = StyleToObject(value);
                if (style.Length > 0)
                    builder.Append(" style={").Append(style).Append('}');
                continue;
            }

            if (lower is "checked" or "selected")
            {
                builder.Append(' ').Append(lower == "checked" ? "defaultChecked" : "defaultSelected");
                if (value.Length > 0 && !value.Equals("true", StringComparison.OrdinalIgnoreCase))
                    builder.Append("={").Append(JsString(value)).Append('}');
                continue;
            }

            if (lower == "value" && (tag is "input" or "textarea" or "select"))
            {
                builder.Append(" defaultValue=").Append('"').Append(HtmlEscape.Attribute(value)).Append('"');
                continue;
            }

            var name = MapAttribute(key, svg);
            if (BooleanAttributes.Contains(lower) && (value.Length == 0 || value.Equals("true", StringComparison.OrdinalIgnoreCase)))
            {
                builder.Append(' ').Append(name);
                continue;
            }
            builder.Append(' ').Append(name).Append("=\"").Append(HtmlEscape.Attribute(value)).Append('"');
        }

        if (voidTag)
        {
            builder.AppendLine(" />");
            return builder.ToString();
        }

        var hasChildren = node.Children.Count > 0;
        if (!hasChildren)
        {
            builder.AppendLine(" />");
            return builder.ToString();
        }

        builder.AppendLine(">");
        var preserve = tag == "pre" || tag == "textarea" ||
                       node.Computed.GetValueOrDefault("white-space", "").StartsWith("pre", StringComparison.Ordinal);

        foreach (var child in node.Children)
            builder.Append(RenderNode(child, plan, entry, false, depth + 1));

        builder.Append(indent).Append("</").Append(tag).AppendLine(">");
        return builder.ToString();
    }

    private static string Indent(string text, int levels)
    {
        var prefix = new string(' ', levels * 2);
        var lines = text.TrimEnd().Split('\n');
        return string.Join("\n", lines.Select(line => line.Length == 0 ? line : prefix + line)) + "\n";
    }

    private static string MapAttribute(string key, bool svg)    {
        if (key.StartsWith("data-", StringComparison.OrdinalIgnoreCase) ||
            key.StartsWith("aria-", StringComparison.OrdinalIgnoreCase))
            return key;
        if (svg && SvgAttributeMap.TryGetValue(key, out var svgName))
            return svgName;
        if (AttributeMap.TryGetValue(key, out var mapped))
            return mapped;
        if (key.Contains('-') && svg)
            return Camel(key);
        return key;
    }

    private static string StyleToObject(string style)
    {
        var parts = StyleParts(style);
        if (parts.Count == 0)
            return "";
        var builder = new StringBuilder("{ ");
        var first = true;
        foreach (var (property, value) in parts)
        {
            if (!first)
                builder.Append(", ");
            first = false;
            var name = property.StartsWith("--", StringComparison.Ordinal)
                ? JsString(property)
                : JsString(property.StartsWith("-", StringComparison.Ordinal) ? VendorCamel(property) : Camel(property));
            builder.Append(name).Append(": ").Append(JsString(value));
        }
        builder.Append(" }");
        return builder.ToString();
    }

    public static List<(string Property, string Value)> StyleParts(string style)
    {
        var result = new List<(string, string)>();
        if (string.IsNullOrWhiteSpace(style))
            return result;

        var current = new StringBuilder();
        var depth = 0;
        var quote = '\0';
        foreach (var ch in style)
        {
            if (quote != '\0')
            {
                current.Append(ch);
                if (ch == quote)
                    quote = '\0';
                continue;
            }
            if (ch is '\'' or '"')
            {
                quote = ch;
                current.Append(ch);
                continue;
            }
            if (ch == '(')
                depth++;
            if (ch == ')')
                depth--;
            if (ch == ';' && depth == 0)
            {
                Add(current.ToString());
                current.Clear();
                continue;
            }
            current.Append(ch);
        }
        Add(current.ToString());
        return result;

        void Add(string declaration)
        {
            var index = declaration.IndexOf(':');
            if (index <= 0)
                return;
            var property = declaration[..index].Trim();
            var value = declaration[(index + 1)..].Trim();
            if (property.Length == 0 || value.Length == 0)
                return;
            result.Add((property, value));
        }
    }

    private static string EscapeJsxText(string text, bool preserve)
    {
        if (text.Length == 0)
            return "";
        var needsExpression = preserve && text.Contains('\n');
        if (needsExpression)
            return "{" + JsString(text) + "}";

        return text
            .Replace("&", "&amp;")
            .Replace("<", "&lt;")
            .Replace(">", "&gt;")
            .Replace("{", "&#123;")
            .Replace("}", "&#125;");
    }

    private static string JsString(string value) =>
        System.Text.Json.JsonSerializer.Serialize(value)
            .Replace("\u2028", "\\u2028")
            .Replace("\u2029", "\\u2029");

    private static string VendorCamel(string value)
    {
        var trimmed = value.TrimStart('-');
        var parts = trimmed.Split('-', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0)
            return value;
        var builder = new StringBuilder(char.ToUpperInvariant(parts[0][0]) + parts[0][1..]);
        foreach (var part in parts.Skip(1))
            builder.Append(char.ToUpperInvariant(part[0])).Append(part[1..]);
        return builder.ToString();
    }

    private static string Camel(string value)
    {        if (string.IsNullOrEmpty(value))
            return value;
        if (value.StartsWith("--", StringComparison.Ordinal))
            return value;
        var parts = value.Split(['-', '_', ' '], StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return char.ToLowerInvariant(value[0]) + value[1..];
        var builder = new StringBuilder(parts[0].ToLowerInvariant());
        foreach (var part in parts.Skip(1))
            builder.Append(char.ToUpperInvariant(part[0])).Append(part[1..]);
        return builder.ToString();
    }
}
