using System.Text;

namespace Clippy;

public static class CsxGenerator
{
    private static readonly HashSet<string> VoidTags = new(StringComparer.OrdinalIgnoreCase)
    {
        "area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta",
        "param", "source", "track", "wbr"
    };

    private static readonly HashSet<string> DedicatedAttributes = new(StringComparer.OrdinalIgnoreCase)
    {
        "class", "id", "title", "role", "href", "src", "alt", "target", "rel",
        "type", "value", "placeholder", "name", "disabled", "checked", "tabindex",
        "loadingpage"
    };

    private static readonly HashSet<string> BooleanAttributes = new(StringComparer.OrdinalIgnoreCase)
    {
        "disabled", "checked", "required", "multiple", "autofocus", "autoplay",
        "controls", "loop", "muted", "open", "hidden", "reversed", "allowfullscreen",
        "default", "defer", "async", "ismap", "nomodule", "playsinline"
    };

    public static string Generate(ComponentEntry entry)
    {
        if (entry.Data?.Root is null)
            return "// No extraction data.";

        var plan = PropertyPlan.Build(entry);
        var name = NameService.FileName(entry.Name);
        var builder = new StringBuilder();
        builder.AppendLine("// " + name + " - generated by Clippy");
        builder.AppendLine("// Source: " + (string.IsNullOrWhiteSpace(entry.SourceUrl) ? "unknown" : entry.SourceUrl));
        builder.AppendLine("// Viewport: " + entry.ViewportWidth + " - " + entry.ViewportHeight);
        builder.AppendLine("// Add " + name + ".css to the consuming project's stylesheets.");
        builder.AppendLine("// Original JavaScript behaviour is not recreated; markup, styling and assets are.");
        builder.AppendLine();
        builder.AppendLine("using System.Collections.Generic;");
        builder.AppendLine("using Donkeh.UILab;");
        builder.AppendLine();
        builder.AppendLine("namespace Components;");
        builder.AppendLine();

        if (plan.Active && plan.Items.Count > 0)
        {
            builder.AppendLine("public sealed class " + name + "Props : Props");
            builder.AppendLine("{");
            foreach (var item in plan.Items)
            {
                builder.AppendLine("    public string " + item.Name + " { get; init; } = " + CsString(item.Default) + ";");
            }
            builder.AppendLine("}");
            builder.AppendLine();
            builder.AppendLine("public sealed class " + name + " : Component<" + name + "Props>");
            builder.AppendLine("{");
            builder.AppendLine("    public override Node Render() =>");
            var markup = RenderNode(entry.Data.Root, plan, isRoot: true, depth: 2);
            builder.Append(WrapContext(markup, entry).TrimEnd());
            builder.AppendLine(";");
            builder.AppendLine("}");
        }
        else
        {
            builder.AppendLine("public sealed class " + name + " : Component");
            builder.AppendLine("{");
            builder.AppendLine("    public override Node Render() =>");
            var markup = RenderNode(entry.Data.Root, plan, isRoot: true, depth: 2);
            builder.Append(WrapContext(markup, entry).TrimEnd());
            builder.AppendLine(";");
            builder.AppendLine("}");
        }

        return builder.ToString();
    }

    private static string WrapContext(string markup, ComponentEntry entry)
    {
        var result = markup.TrimEnd();
        var chain = entry.Data?.ContextChain ?? [];
        for (var i = chain.Count - 1; i >= 0; i--)
        {
            result = "        <div className=\"clippy-context-" + (i + 1) + "\">\n" +
                     IndentLines(result, 4) +
                     "\n        </div>";
        }
        return result + "\n";
    }

    private static string IndentLines(string text, int spaces)
    {
        var prefix = new string(' ', spaces);
        return string.Join("\n", text.Split('\n').Select(line => line.Length == 0 ? line : prefix + line));
    }

    private static string RenderNode(SerializedNode node, PropertyPlan plan, bool isRoot, int depth)
    {
        var indent = new string(' ', depth * 4);
        var tag = node.Tag;
        if (string.IsNullOrWhiteSpace(tag))
            return "";

        if (tag == "#text")
        {
            var textIndent = new string(' ', depth * 4);
            var textBuilder = new StringBuilder();
            if (plan.TryText(node, out var textProp))
                textBuilder.Append(textIndent).Append("{Props.").Append(textProp).AppendLine("}");
            else if (!string.IsNullOrWhiteSpace(node.Text))
                textBuilder.Append(textIndent).Append('{').Append(CsString(node.Text)).AppendLine("}"); 
            return textBuilder.ToString();
        }

        if (tag is "html" or "body")
            tag = "div";

        var svg = node.IsSvg || node.Attributes.ContainsKey("viewBox") || node.Tag == "svg";
        var voidTag = new[] { "img", "input", "br", "hr", "source", "track", "area", "base", "col", "embed", "link", "meta", "param", "wbr" }
            .Contains(tag, StringComparer.OrdinalIgnoreCase);
        var builder = new StringBuilder();
        builder.Append(indent).Append('<').Append(tag);

        var classList = new List<string>();
        if (isRoot)
            classList.Add("clippy-root");
        var classes = node.Attributes.GetValueOrDefault("class", "");
        if (!string.IsNullOrWhiteSpace(classes))
            classList.Add(classes);
        if (node.Fallback || (node.Index > 0 && node.MatchedRules == 0))
            classList.Add(node.FallbackClass);
        if (classList.Count > 0)
            builder.Append(" className=\"").Append(HtmlEscape.Attribute(string.Join(" ", classList))).Append('"');

        var extra = new List<(string Name, string Value)>();

        foreach (var kv in node.Attributes)
        {
            var key = kv.Key;
            var lower = key.ToLowerInvariant();
            if (lower == "class")
                continue;
            if (lower.StartsWith("on") && lower.Length > 2)
                continue;
            if (lower is "srcdoc" or "integrity" or "nonce" or "ping" or "crossorigin")
                continue;
            var value = kv.Value;
            if ((lower is "href" or "src" or "action" or "formaction" or "data") &&
                value.TrimStart().StartsWith("javascript:", StringComparison.OrdinalIgnoreCase))
                continue;

            if (plan.TryAttribute(node, lower, out var prop))
            {
                builder.Append(' ').Append(PropAttributeName(lower)).Append("={Props.").Append(prop).Append('}');
                continue;
            }

            switch (lower)
            {
                case "id":
                    builder.Append(" id=\"").Append(HtmlEscape.Attribute(value)).Append('"');
                    break;
                case "title":
                    builder.Append(" title=\"").Append(HtmlEscape.Attribute(value)).Append('"');
                    break;
                case "role":
                    builder.Append(" role=\"").Append(HtmlEscape.Attribute(value)).Append('"');
                    break;
                case "href":
                    builder.Append(" href=\"").Append(HtmlEscape.Attribute(value)).Append('"');
                    break;
                case "src":
                    builder.Append(" src=\"").Append(HtmlEscape.Attribute(value)).Append('"');
                    break;
                case "alt":
                    builder.Append(" alt=\"").Append(HtmlEscape.Attribute(value)).Append('"');
                    break;
                case "target":
                    builder.Append(" target=\"").Append(HtmlEscape.Attribute(value)).Append('"');
                    break;
                case "rel":
                    builder.Append(" rel=\"").Append(HtmlEscape.Attribute(value)).Append('"');
                    break;
                case "type":
                    builder.Append(" type=\"").Append(HtmlEscape.Attribute(value)).Append('"');
                    break;
                case "value":
                    builder.Append(" value=\"").Append(HtmlEscape.Attribute(value)).Append('"');
                    break;
                case "placeholder":
                    builder.Append(" placeholder=\"").Append(HtmlEscape.Attribute(value)).Append('"');
                    break;
                case "name":
                    builder.Append(" name=\"").Append(HtmlEscape.Attribute(value)).Append('"');
                    break;
                case "tabindex":
                    if (int.TryParse(value, out var tabIndex))
                        builder.Append(" tabIndex={").Append(tabIndex).Append('}');
                    else
                        extra.Add((key, value));
                    break;
                case "disabled":
                    builder.Append(value.Length == 0 || value.Equals("true", StringComparison.OrdinalIgnoreCase)
                        ? " disabled"
                        : " disabled={" + (value.Equals("false", StringComparison.OrdinalIgnoreCase) ? "false" : "true") + "}");
                    break;
                case "checked":
                    builder.Append(value.Length == 0 || value.Equals("true", StringComparison.OrdinalIgnoreCase)
                        ? " checked"
                        : " checked={" + (value.Equals("false", StringComparison.OrdinalIgnoreCase) ? "false" : "true") + "}");
                    break;
                default:
                    extra.Add((key, value));
                    break;
            }
        }

        if (extra.Count > 0)
        {
            builder.Append(" Attributes={new Dictionary<string, string> { ");
            var first = true;
            foreach (var (attrName, attrValue) in extra)
            {
                if (!first)
                    builder.Append(", ");
                first = false;
                builder.Append('[').Append(CsString(attrName)).Append("] = ").Append(CsString(attrValue));
            }
            builder.Append(" }}");
        }

        var hasChildren = node.Children.Count > 0;
        if (voidTag || !hasChildren)
        {
            builder.AppendLine(" />");
            return builder.ToString();
        }

        builder.AppendLine(">");


        foreach (var child in node.Children)
            builder.Append(RenderNode(child, plan, false, depth + 1));

        builder.Append(indent).Append("</").Append(tag).AppendLine(">");
        return builder.ToString();
    }

    private static string PropAttributeName(string attribute) => attribute.ToLowerInvariant() switch
    {
        "src" => "src",
        "href" => "href",
        _ => attribute
    };

    private static string CsString(string value) =>
        "\"" + value
            .Replace("\\", "\\\\")
            .Replace("\"", "\\\"")
            .Replace("\r", "\\r")
            .Replace("\n", "\\n")
            .Replace("\t", "\\t")
        + "\"";
}
