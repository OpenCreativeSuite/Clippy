using System.Text;
using System.Text.Json;
using System.Text.RegularExpressions;

namespace Clippy;

/// <summary>
/// Converts the generated JSX/CSX source back into static HTML for the live
/// preview. Only the static markup subset produced by Clippy is interpreted;
/// no extracted code is ever executed.
/// </summary>
public static class StaticPreview
{
    private static readonly HashSet<string> VoidTags = new(StringComparer.OrdinalIgnoreCase)
    {
        "area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta",
        "param", "source", "track", "wbr"
    };

    private static readonly Dictionary<string, string> AttributeNames = new(StringComparer.OrdinalIgnoreCase)
    {
        ["className"] = "class",
        ["htmlFor"] = "for",
        ["srcSet"] = "srcset",
        ["imageSrcSet"] = "imagesrcset",
        ["imageSizes"] = "imagesizes",
        ["tabIndex"] = "tabindex",
        ["readOnly"] = "readonly",
        ["defaultChecked"] = "checked",
        ["defaultSelected"] = "selected",
        ["defaultValue"] = "value",
        ["autoComplete"] = "autocomplete",
        ["autoFocus"] = "autofocus",
        ["autoPlay"] = "autoplay",
        ["contentEditable"] = "contenteditable",
        ["colSpan"] = "colspan",
        ["rowSpan"] = "rowspan",
        ["maxLength"] = "maxlength",
        ["minLength"] = "minlength",
        ["spellCheck"] = "spellcheck",
        ["strokeWidth"] = "stroke-width",
        ["strokeLinecap"] = "stroke-linecap",
        ["strokeLinejoin"] = "stroke-linejoin",
        ["strokeDasharray"] = "stroke-dasharray",
        ["strokeDashoffset"] = "stroke-dashoffset",
        ["strokeMiterlimit"] = "stroke-miterlimit",
        ["strokeOpacity"] = "stroke-opacity",
        ["fillRule"] = "fill-rule",
        ["fillOpacity"] = "fill-opacity",
        ["clipRule"] = "clip-rule",
        ["clipPath"] = "clip-path",
        ["stopColor"] = "stop-color",
        ["stopOpacity"] = "stop-opacity",
        ["textAnchor"] = "text-anchor",
        ["fontFamily"] = "font-family",
        ["fontSize"] = "font-size",
        ["fontWeight"] = "font-weight",
        ["fontStyle"] = "font-style",
        ["dominantBaseline"] = "dominant-baseline",
        ["vectorEffect"] = "vector-effect",
        ["shapeRendering"] = "shape-rendering",
        ["preserveAspectRatio"] = "preserveAspectRatio",
        ["xlinkHref"] = "xlink:href",
        ["xmlSpace"] = "xml:space"
    };

    public static string FromComponentSource(string source, ComponentEntry entry)
    {
        if (string.IsNullOrWhiteSpace(source))
            return "";

        try
        {
            var markup = ExtractMarkup(source);
            if (string.IsNullOrWhiteSpace(markup))
                return "";

            var plan = PropertyPlan.Build(entry);
            var defaults = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            if (plan.Active)
            {
                foreach (var item in plan.Items)
                {
                    defaults[item.Name] = item.Default;
                    defaults[Camel(item.Name)] = item.Default;
                }
            }
            defaults["children"] = "";

            var output = new StringBuilder();
            Convert(markup, defaults, output);
            var html = output.ToString().Trim();
            if (html.Length == 0)
                return "";
            return html;
        }
        catch
        {
            return "";
        }
    }

    private static string ExtractMarkup(string source)
    {
        var returnIndex = source.LastIndexOf("return", StringComparison.Ordinal);
        var arrowIndex = source.LastIndexOf("=>", StringComparison.Ordinal);
        var anchor = Math.Max(returnIndex, arrowIndex);
        if (anchor < 0)
            anchor = 0;

        var start = source.IndexOf('<', anchor);
        if (start < 0 || start + 1 >= source.Length || !(char.IsLetter(source[start + 1]) || source[start + 1] == '>'))
            return "";

        var depth = 0;
        var seen = false;
        for (var i = start; i < source.Length; i++)
        {
            if (source[i] != '<')
                continue;
            if (i + 3 < source.Length && source.Substring(i, 4) == "<!--")
            {
                var commentEnd = source.IndexOf("-->", i + 4, StringComparison.Ordinal);
                if (commentEnd < 0)
                    return "";
                i = commentEnd + 2;
                continue;
            }

            var closing = i + 1 < source.Length && source[i + 1] == '/';
            var tagEnd = FindTagEnd(source, i + 1);
            if (tagEnd < 0)
                break;

            var tagText = source.Substring(i, tagEnd - i + 1);
            var selfClosing = tagText.TrimEnd().EndsWith("/>", StringComparison.Ordinal);
            var name = ReadTagName(tagText);
            if (!closing)
            {
                if (!selfClosing && !VoidTags.Contains(name))
                    depth++;
                seen = true;
            }
            else
            {
                depth--;
                if (seen && depth <= 0)
                    return source[start..(tagEnd + 1)];
            }

            i = tagEnd;
        }

        return seen ? source[start..] : "";
    }

    private static int FindTagEnd(string source, int start)
    {
        var quote = '\0';
        var braces = 0;
        for (var i = start; i < source.Length; i++)
        {
            var ch = source[i];
            if (quote != '\0')
            {
                if (ch == quote && (i == 0 || source[i - 1] != '\\'))
                    quote = '\0';
                continue;
            }
            if (ch is '"' or '\'')
            {
                quote = ch;
                continue;
            }
            if (ch == '{')
            {
                braces++;
                continue;
            }
            if (ch == '}')
            {
                braces--;
                continue;
            }
            if (ch == '>' && braces <= 0)
                return i;
        }
        return -1;
    }

    private static string ReadTagName(string tagText)
    {
        var text = tagText.TrimStart('<', '/', ' ');
        var end = 0;
        while (end < text.Length && (char.IsLetterOrDigit(text[end]) || text[end] is '-' or '_' or ':'))
            end++;
        return text[..end];
    }

    private static void Convert(string markup, Dictionary<string, string> defaults, StringBuilder output)
    {
        var index = 0;
        while (index < markup.Length)
        {
            if (markup[index] == '<')
            {
                if (index + 3 < markup.Length && markup.Substring(index, 4) == "<!--")
                {
                    var end = markup.IndexOf("-->", index + 4, StringComparison.Ordinal);
                    index = end < 0 ? markup.Length : end + 3;
                    continue;
                }

                var closing = index + 1 < markup.Length && markup[index + 1] == '/';
                var tagEnd = FindTagEnd(markup, index + 1);
                if (tagEnd < 0)
                    break;

                var tagText = markup.Substring(index, tagEnd - index + 1);
                var name = ReadTagName(tagText);
                if (string.IsNullOrWhiteSpace(name))
                {
                    output.Append(tagText);
                    index = tagEnd + 1;
                    continue;
                }

                var selfClosing = tagText.TrimEnd().EndsWith("/>", StringComparison.Ordinal);
                var attributes = closing ? "" : tagText[(tagText.IndexOf(name, StringComparison.Ordinal) + name.Length)..];
                if (!closing && attributes.EndsWith(">", StringComparison.Ordinal))
                    attributes = attributes[..^1];
                if (attributes.EndsWith("/", StringComparison.Ordinal))
                    attributes = attributes[..^1];

                output.Append('<').Append(closing ? "/" : "").Append(name);
                if (!closing)
                {
                    var converted = ConvertAttributes(attributes, defaults);
                    if (converted.Length > 0)
                        output.Append(' ').Append(converted);
                }

                if (!closing && (selfClosing || VoidTags.Contains(name)))
                {
                    output.Append('>');
                    index = tagEnd + 1;
                    continue;
                }

                output.Append('>');
                index = tagEnd + 1;
                continue;
            }

            var nextTag = markup.IndexOf('<', index);
            var textEnd = nextTag < 0 ? markup.Length : nextTag;
            var text = markup[index..textEnd];
            output.Append(ConvertText(text, defaults));
            index = textEnd;
        }
    }

    private static string ConvertAttributes(string raw, Dictionary<string, string> defaults)
    {
        var builder = new StringBuilder();
        var index = 0;
        while (index < raw.Length)
        {
            while (index < raw.Length && char.IsWhiteSpace(raw[index]))
                index++;
            if (index >= raw.Length)
                break;

            var nameStart = index;
            while (index < raw.Length && !char.IsWhiteSpace(raw[index]) && raw[index] != '=' &&
                   raw[index] != '>' && raw[index] != '/')
                index++;

            if (index == nameStart)
            {
                index++;
                continue;
            }

            var name = raw[nameStart..index].Trim();
            if (name.Length == 0)
                continue;

            while (index < raw.Length && char.IsWhiteSpace(raw[index]))
                index++;

            if (index >= raw.Length || raw[index] != '=')
            {
                // Boolean attribute.
                var mappedBool = MapName(name);
                if (mappedBool.Length > 0)
                    builder.Append(' ').Append(mappedBool);
                continue;
            }

            index++; // =
            while (index < raw.Length && char.IsWhiteSpace(raw[index]))
                index++;

            if (index >= raw.Length)
                break;

            string value;
            if (raw[index] is '"' or '\'')
            {
                var quote = raw[index++];
                var valueStart = index;
                while (index < raw.Length && raw[index] != quote)
                {
                    if (raw[index] == '\\' && index + 1 < raw.Length)
                        index++;
                    index++;
                }
                value = raw[valueStart..Math.Min(index, raw.Length)];
                if (index < raw.Length)
                    index++;
            }
            else if (raw[index] == '{')
            {
                var expression = ReadBraced(raw, ref index);
                value = ResolveExpression(expression, name, defaults, builder);
                if (value == "__DROPPED__")
                    continue;
            }
            else
            {
                var valueStart = index;
                while (index < raw.Length && !char.IsWhiteSpace(raw[index]) && raw[index] != '>')
                    index++;
                value = raw[valueStart..index];
            }

            var mapped = MapName(name);
            if (mapped == "Attributes" || mapped == "attributes")
            {
                // The CSX dictionary has already been expanded by ResolveExpression.
                continue;
            }
            if (mapped.Length == 0)
                continue;

            if (value.Length == 0)
                builder.Append(' ').Append(mapped);
            else
                builder.Append(' ').Append(mapped).Append("=\"").Append(HtmlEscape.Attribute(value)).Append('"');
        }

        return builder.ToString().Trim();
    }

    private static string ReadBraced(string raw, ref int index)
    {
        var depth = 0;
        var start = index;
        var quote = '\0';
        while (index < raw.Length)
        {
            var ch = raw[index];
            if (quote != '\0')
            {
                if (ch == quote && raw[index - 1] != '\\')
                    quote = '\0';
            }
            else if (ch is '"' or '\'')
            {
                quote = ch;
            }
            else if (ch == '{')
            {
                depth++;
            }
            else if (ch == '}')
            {
                depth--;
                if (depth == 0)
                {
                    index++;
                    return raw[start..index];
                }
            }
            index++;
        }
        return raw[start..];
    }

    private static string ResolveExpression(
        string expression,
        string attributeName,
        Dictionary<string, string> defaults,
        StringBuilder? extraAttributes)
    {
        var inner = expression.Trim();
        if (inner.StartsWith('{') && inner.EndsWith('}'))
            inner = inner[1..^1].Trim();

        if (attributeName.Equals("Attributes", StringComparison.OrdinalIgnoreCase))
        {
            var dict = Regex.Matches(inner,
                "\\[\\s*\"(?<k>(?:\\\\.|[^\"])*)\"\\s*\\]\\s*=\\s*\"(?<v>(?:\\\\.|[^\"])*)\"");
            foreach (Match match in dict)
            {
                var key = Unescape(match.Groups["k"].Value);
                var value = Unescape(match.Groups["v"].Value);
                extraAttributes?.Append(' ').Append(key).Append("=\"").Append(HtmlEscape.Attribute(value)).Append('"');
            }
            return "__DROPPED__";
        }

        if (attributeName.Equals("style", StringComparison.OrdinalIgnoreCase) && inner.StartsWith('{'))
        {
            return StyleObjectToCss(inner);
        }

        // A quoted string expression: {"text"}
        var quoted = TryStringLiteral(inner);
        if (quoted is not null)
            return quoted;

        // Props.Title / title / item.Name
        var name = inner.Split('.')[^1].Trim();
        if (defaults.TryGetValue(name, out var valueDefault))
            return valueDefault;

        if (inner is "true")
            return "";
        if (inner is "false" or "null" or "undefined")
            return "__DROPPED__";
        if (int.TryParse(inner, out _) || double.TryParse(inner, out _))
            return inner;

        return "";
    }

    private static string StyleObjectToCss(string inner)
    {
        inner = inner.Trim();
        if (inner.StartsWith("{{") && inner.EndsWith("}}"))
            inner = inner[2..^2];
        else if (inner.StartsWith('{') && inner.EndsWith('}'))
            inner = inner[1..^1];

        var parts = SplitTopLevel(inner, ',');
        var declarations = new List<string>();
        foreach (var part in parts)
        {
            var colon = part.IndexOf(':');
            if (colon <= 0)
                continue;
            var key = part[..colon].Trim().Trim('"', '\'');
            var value = part[(colon + 1)..].Trim();
            var literal = TryStringLiteral(value) ?? value.Trim('"', '\'');
            if (key.Length == 0 || literal.Length == 0)
                continue;
            declarations.Add(Kebab(key) + ": " + literal);
        }
        return string.Join("; ", declarations) + (declarations.Count > 0 ? ";" : "");
    }

    private static string ConvertText(string text, Dictionary<string, string> defaults)
    {
        if (text.Length == 0)
            return "";
        var builder = new StringBuilder();
        var index = 0;
        while (index < text.Length)
        {
            if (text[index] == '{')
            {
                var depth = 0;
                var start = index;
                var quote = '\0';
                while (index < text.Length)
                {
                    var ch = text[index];
                    if (quote != '\0')
                    {
                        if (ch == quote && (index == 0 || text[index - 1] != '\\'))
                            quote = '\0';
                    }
                    else if (ch is '"' or '\'')
                    {
                        quote = ch;
                    }
                    else if (ch == '{')
                    {
                        depth++;
                    }
                    else if (ch == '}')
                    {
                        depth--;
                        if (depth == 0)
                        {
                            index++;
                            break;
                        }
                    }
                    index++;
                }
                var expression = text[start..index].Trim();
                var inner = expression.Length >= 2 ? expression[1..^1].Trim() : "";
                var literal = TryStringLiteral(inner);
                if (literal is not null)
                {
                    builder.Append(HtmlEscape.Text(literal));
                }
                else
                {
                    var name = inner.Split('.')[^1].Trim();
                    if (defaults.TryGetValue(name, out var value))
                        builder.Append(HtmlEscape.Text(value));
                }
                continue;
            }

            var next = text.IndexOf('{', index);
            var chunk = next < 0 ? text[index..] : text[index..next];
            builder.Append(Regex.Replace(chunk, @"\s+", " "));
            index = next < 0 ? text.Length : next;
        }
        return builder.ToString();
    }

    private static string? TryStringLiteral(string expression)
    {
        var text = expression.Trim();
        if (text.Length < 2 || text[0] != '"' || text[^1] != '"')
            return null;
        try
        {
            return JsonSerializer.Deserialize<string>(text);
        }
        catch
        {
            return text[1..^1].Replace("\\\"", "\"").Replace("\\\\", "\\");
        }
    }

    private static string MapName(string name)
    {
        if (name.StartsWith("data-", StringComparison.OrdinalIgnoreCase) ||
            name.StartsWith("aria-", StringComparison.OrdinalIgnoreCase))
            return name;
        if (AttributeNames.TryGetValue(name, out var mapped))
            return mapped;
        if (name.Contains('-'))
            return name;
        return Kebab(name);
    }

    private static string Kebab(string value)
    {
        if (value.StartsWith("--", StringComparison.Ordinal))
            return value;
        var builder = new StringBuilder();
        for (var i = 0; i < value.Length; i++)
        {
            var ch = value[i];
            if (char.IsUpper(ch))
            {
                if (i > 0)
                    builder.Append('-');
                builder.Append(char.ToLowerInvariant(ch));
            }
            else
            {
                builder.Append(ch);
            }
        }
        return builder.ToString();
    }

    private static List<string> SplitTopLevel(string text, char separator)
    {
        var result = new List<string>();
        var current = new StringBuilder();
        var depth = 0;
        var quote = '\0';
        foreach (var ch in text)
        {
            if (quote != '\0')
            {
                current.Append(ch);
                if (ch == quote)
                    quote = '\0';
                continue;
            }
            if (ch is '"' or '\'')
            {
                quote = ch;
                current.Append(ch);
                continue;
            }
            if (ch is '{' or '[' or '(')
                depth++;
            if (ch is '}' or ']' or ')')
                depth--;
            if (ch == separator && depth == 0)
            {
                result.Add(current.ToString());
                current.Clear();
                continue;
            }
            current.Append(ch);
        }
        if (current.Length > 0)
            result.Add(current.ToString());
        return result;
    }

    private static string Unescape(string value)
    {
        try
        {
            return JsonSerializer.Deserialize<string>("\"" + value + "\"") ?? value;
        }
        catch
        {
            return value.Replace("\\\"", "\"").Replace("\\\\", "\\");
        }
    }

    private static string Camel(string value)
    {
        if (string.IsNullOrEmpty(value))
            return value;
        return char.ToLowerInvariant(value[0]) + value[1..];
    }
}
