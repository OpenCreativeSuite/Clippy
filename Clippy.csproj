<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Clippy</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);builds/**;**/bin/**;**/obj/**</DefaultItemExcludes>
    <DonkehVersion Condition="'$(DonkehVersion)' == ''">1.0.55</DonkehVersion>
    <DonkehDesktop>true</DonkehDesktop>
    <RuntimeIdentifier Condition="'$(OS)' == 'Windows_NT' and '$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <NoWarn>$(NoWarn);CS8669;CS8604;CS8602;CS8600;CS8618;NU1504</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Donkeh.Windowing" Version="$(DonkehVersion)" />
    <PackageReference Include="CefSharp.OffScreen.NETCore" Version="134.3.90" />
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="src/Styles.css" />
    <EmbeddedResource Include="src/browser/inspector.js" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="src/Assets/Fonts/fa-solid-900.woff2">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets/fonts/fa-solid-900.woff2</Link>
    </Content>
  </ItemGroup>

  <!-- Add Android or browser targets with:
       donkeh enable-target android
       donkeh enable-target web -->

</Project>